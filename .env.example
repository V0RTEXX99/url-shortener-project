# NOTE: DO NOT USE THIS FILE FOR STORING ENV VARIABLES
# MAKE SEPARATE .env FILE AND ADD TO .gitignore
# ADD ENV VARIABLES IN THAT .env FILE

# PostgreSQL
DB_NAME=your_db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5433

# Spring Security
SECURITY_USERNAME=your_preferred_username
SECURITY_PASSWORD=your_preferred_password

# Spring Boot
SERVER_PORT=8081
